<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#F8F9FA">

    <!-- Título superior -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hola ¿Qué vamos a trabajar hoy?"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:textAlignment="center"
        android:layout_marginBottom="40dp" />

    <!-- Cuadrícula para los 4 botones -->
    <GridLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:columnCount="2"
        android:rowCount="2">

        <Button
            android:id="@+id/btnBrazos"
            android:layout_width="140dp"
            android:layout_height="60dp"
            android:text="Brazos"
            android:layout_margin="12dp"
            android:backgroundTint="#E8EAF6"
            android:textColor="#000000" />

        <Button
            android:id="@+id/btnEspalda"
            android:layout_width="140dp"
            android:layout_height="60dp"
            android:text="Espalda"
            android:layout_margin="12dp"
            android:backgroundTint="#E8EAF6"
            android:textColor="#000000" />

        <Button
            android:id="@+id/btnPierna"
            android:layout_width="140dp"
            android:layout_height="60dp"
            android:text="Pierna"
            android:layout_margin="12dp"
            android:backgroundTint="#E8EAF6"
            android:textColor="#000000" />

        <Button
            android:id="@+id/btnPecho"
            android:layout_width="140dp"
            android:layout_height="60dp"
            android:text="Pecho"
            android:layout_margin="12dp"
            android:backgroundTint="#E8EAF6"
            android:textColor="#000000" />

    </GridLayout>
</LinearLayout>